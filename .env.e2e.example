# Local Supabase values. Run `supabase status -o env` to get current keys.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required only when intentionally targeting a disposable remote test project.
# E2E_ALLOW_REMOTE=1

# Required only for preview or production-style builds.
# EXPO_PUBLIC_E2E=1
