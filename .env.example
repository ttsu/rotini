# App runtime
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
# Optional — enables verbose Sentry SDK logging when true (see lib/sentry.ts)
# EXPO_PUBLIC_SENTRY_DEBUG=

# EAS metadata
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Set by CI to the git SHA so Sentry can identify which OTA update is running
EXPO_PUBLIC_SENTRY_DIST=

# Sentry source map upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io/
