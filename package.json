{
  "name": "rotini",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:prepare": "node ./maestro/support/prepare-local.js",
    "e2e:start": "node ./maestro/support/with-e2e-env.js expo start --clear",
    "e2e:android": "node ./maestro/support/with-e2e-env.js expo run:android",
    "e2e:ios": "node ./maestro/support/with-e2e-env.js expo run:ios",
    "e2e:test": "npm run e2e:prepare && maestro test maestro/flows",
    "manual:seed": "node ./scripts/manual-test-seed.js",
    "manual:seed:reset": "node ./scripts/manual-test-seed.js --reset",
    "format": "prettier --write .",
    "build:production": "npx eas-cli build --platform all --profile production",
    "submit:production": "npx eas-cli submit --platform all --profile production --latest",
    "db:types": "supabase gen types typescript --project-id hvruvvedzsnlwsotzwqg > lib/database.types.ts",
    "sync-rrule": "node ./scripts/sync-rrule.js"
  },
  "dependencies": {
    "@expo/ui": "57.0.4",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/query-async-storage-persister": "^5.100.8",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-persist-client": "^5.100.8",
    "buffer": "^5.7.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.4",
    "expo-apple-authentication": "~57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-calendar": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "libphonenumber-js": "^1.12.42",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.74.0",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.2",
    "rrule": "^2.8.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.18",
    "brace-expansion@<2": "^1.1.17",
    "brace-expansion@>=4": "^5.0.8",
    "uuid": "^11.1.1"
  }
}
